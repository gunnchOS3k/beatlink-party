{
  "name": "beatlink-party",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BeatLink Party — rhythm + karaoke phone-controller party game",
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:server\"",
    "dev:web": "pnpm --filter @beatlink/web dev",
    "dev:server": "pnpm --filter @beatlink/server dev",
    "server:dev": "pnpm --filter @beatlink/server dev",
    "server:device": "pnpm --filter @beatlink/server dev:device",
    "server:prod": "pnpm build && pnpm --filter @beatlink/server start:prod",
    "server:health": "pnpm --filter @beatlink/server health",
    "device:test:android": "node scripts/device-test-android.mjs",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:e2e": "BEATLINK_E2E=1 playwright test tests/e2e/party.playwright.spec.ts",
    "test:network-load": "vitest run tests/network_load.test.ts",
    "test:redis-ci": "vitest run tests/redis_ci.test.ts",
    "test:continuation-vi": "vitest run tests/continuation_vi.test.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:watch": "vitest",
    "emit:digital-rc": "vitest run scripts/emit-digital-rc.test.ts",
    "validate:game-rc": "python3 scripts/validate_game_rc_contracts.py",
    "compose:redis": "docker compose up -d redis",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "pnpm --filter @beatlink/shared build && pnpm --filter @beatlink/game-engine build && pnpm --filter @beatlink/device-ux build && pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "playwright": "1.49.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
