# Server
PORT=3001
# Default bind is loopback via BEATLINK_BIND_HOST (see loopbackBind.mjs).
# For phone+TV Wi-Fi party testing ONLY (trusted LAN):
#   BEATLINK_PARTY_LAN=1
#   BEATLINK_BIND_HOST=0.0.0.0
# Docs: docs/LAN_PARTY_PHONE_TV.md
BEATLINK_BIND_HOST=127.0.0.1
# BEATLINK_PARTY_LAN=0
CORS_ORIGIN=http://localhost:5173

# Web (Vite)
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001

# Future production (not required for MVP)
# REDIS_URL=redis://localhost:6379
# DATABASE_URL=postgresql://user:pass@localhost:5432/beatlink
